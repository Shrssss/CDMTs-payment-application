<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cdmts.paymentApps.mapper.OrderMapper">

    <!-- ORDERマップ -->
    <resultMap id="orderMap" type="com.cdmts.paymentApps.model.entity.Order">
        <id column="ORDERID" property="orderId"/>
        <result column="ORDER_DATE" property="orderDate"/>
        <result column="RESERVED_TIME" property="reservedTime"/>
        <result column="SERVING_STATUS" property="servingStatus"/>
        <result column="PAYMENTID" property="paymentId"/>
        <result column="PAYMENT_STATUS" property="paymentStatus"/>
        <result column="IDEMPOTENCY_KEY" property="idempotencyKey"/>
    </resultMap>



    <select id="selectOrdersByOrderIds" resultMap="orderMap">
        SELECT ORDERID, ORDER_DATE, RESERVED_TIME, SERVING_STATUS, PAYMENTID, PAYMENT_STATUS, IDEMPOTENCY_KEY
        FROM ORDER_TABLE
        WHERE ORDERID IN
        <foreach item="orderId" collection="orderIds" open="(" separator="," close=")">
        	#{orderId}
        </foreach>
    </select>

    <select id="selectAllOrders" resultMap="orderMap">
        SELECT ORDERID, ORDER_DATE, RESERVED_TIME, SERVING_STATUS, PAYMENTID, PAYMENT_STATUS, IDEMPOTENCY_KEY
        FROM ORDER_TABLE
    </select>

    <select id="selectServingStatusByOrderId" resultType="Short">
        SELECT SERVING_STATUS
        FROM ORDER_TABLE
        WHERE ORDERID = #{orderId}
    </select>

    <select id="selectOrdersByServingStatus" resultMap="orderMap">
        SELECT ORDERID, ORDER_DATE, RESERVED_TIME, SERVING_STATUS, PAYMENTID, PAYMENT_STATUS, IDEMPOTENCY_KEY
        FROM ORDER_TABLE
        WHERE SERVING_STATUS = #{servingStatus}
    </select>

<!--
	<select id="selectPaymentStatusByOrderId" resultType="boolean" parameterType="int">
        SELECT PAYMENT_STATUS
        FROM ORDER_TABLE
        WHERE ORDERID = #{orderId}
    </select>



	<select id="selectIdempotencyKeyByOrderId" resultType="String" parameterType="int">
   		 SELECT IDEMPOTENCY_KEY
   		 FROM ORDER_TABLE
    	WHERE ORDERID = #{orderId}
	</select>
-->


    <insert id="insertOrder" parameterType="com.cdmts.paymentApps.model.entity.Order" useGeneratedKeys="true" keyProperty="orderId">
        INSERT INTO ORDER_TABLE (ORDER_DATE, RESERVED_TIME, SERVING_STATUS, PAYMENTID, PAYMENT_STATUS, IDEMPOTENCY_KEY)
        VALUES (#{orderDate}, #{reservedTime}, #{servingStatus}, #{paymentId}, #{paymentStatus}, #{idempotencyKey})
    </insert>


    
    <update id="updateServingStatusByOrderId">
        UPDATE ORDER_TABLE
        SET SERVING_STATUS = #{servingStatus}
        WHERE ORDERID = #{orderId}
    </update>
<!--    
    <update id="updatePaymentIdByOrderId">
    	UPDATE ORDER_TABLE
   		SET PAYMENTID = #{paymentId}
   		WHERE ORDERID = #{orderId}
    </update>
-->
    <update id="updatePaymentStatusByOrderId">
        UPDATE ORDER_TABLE
        SET PAYMENT_STATUS = #{paymentStatus}
        WHERE ORDERID = #{orderId}
    </update>
<!--
    <update id="updateIdempotencyKeyByOrderId" parameterType="com.cdmts.paymentApps.model.entity.Order">
    	UPDATE ORDER_TABLE
   		SET IDEMPOTENCY_KEY = #{idempotencyKey}
   		WHERE ORDERID = #{orderId}
    </update>
-->

</mapper>
