# このファイルは雛形です。実際に使う値は各自 .env.local(ローカル開発用、git管理外)/
# .env.production(本番ビルド用、git管理下)にコピーして書いてください。
# このファイル自体に実際の秘密情報を書かないこと(git管理下のため)。

# ⚠️ 以下3つのVITE_SQUARE_*は未使用(Square廃止に伴い隔離。src/legacy/square/でのみ参照される)
VITE_SQUARE_ENV=SANDBOX
VITE_SQUARE_APP_ID=your_square_app_id
VITE_SQUARE_LOCATION_ID=your_location_id

# ⚠️⚠️⚠️ モックスイッチ。本番では以下3つとも必ずfalseにすること(未設定時のデフォルトはtrue)
VITE_USE_MOCK_PAYMENT=false
VITE_USE_MOCK_MENU=false
VITE_USE_TEST_TIME=false